# Backend Environment Configuration
PORT=3001
DB_PATH=./data/crawler-watch.db
UPLOAD_DIR=./data/uploads
LOG_DIR=./data/logs

# Sync Configuration (for fetching remote client logs)
SYNC_ENABLED=false
SYNC_REMOTE_BASE_URL=https://your-client-server.com/logs
SYNC_AUTH_TOKEN=your-secret-token-here

# CORS - frontend origin
FRONTEND_URL=http://localhost:5173
